# Server-side only. Consumed by the edge proxy (api/[...path].ts) and the Vite
# dev proxy. NOT prefixed VITE_, so it is never inlined into the client bundle.
API_UPSTREAM_ORIGIN=https://api.example.com

# Origin of the Supabase project, used to build the CSP connect-src allowlist
# in middleware.ts. Server-side only.
SUPABASE_ORIGIN=https://your-project.supabase.co

# Public (inlined into the bundle). Required for direct-to-storage KYC uploads.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
