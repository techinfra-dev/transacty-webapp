# Public (inlined into the bundle). API host without a trailing /portal —
# the client appends /portal/ (e.g. https://api.example.com → /portal/auth/login).
VITE_BASE_URL=https://api.example.com

# Origin of the Supabase project, used to build the CSP connect-src allowlist
# in middleware.ts. Server-side only.
SUPABASE_ORIGIN=https://your-project.supabase.co

# Public (inlined into the bundle). Required for direct-to-storage KYC uploads.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
